#!/usr/bin/env bash
set -euo pipefail

SCHEMA="org.gnome.settings-daemon.plugins.media-keys"
BASE="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings"
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

declare -A LABEL=(
  [power]="Power menu"
  [shortcuts]="Shortcuts menu"
  [terminal]="Terminal"
)
declare -A BIND=(
  [power]="<Super>x"
  [shortcuts]="<Super>c"
  [terminal]="<Super>t"
)
declare -A COMMAND=(
  [power]="$DIR/power-menu"
  [shortcuts]="$DIR/shortcuts-menu"
  [terminal]="ghostty"
)

if ! gsettings writable "$SCHEMA" custom-keybindings >/dev/null 2>&1; then
  echo "setup-keybindings: $SCHEMA is not writable (running GNOME session?)" >&2
  exit 1
fi

unquote() { local s="${1//\'/}"; printf '%s' "${s//\"/}"; }

raw="$(gsettings get "$SCHEMA" custom-keybindings | tr -d '[]')"
IFS=',' read -ra parts <<< "$raw"
keep=()
for path in "${parts[@]}"; do
  path="$(unquote "${path// /}")"
  [ -n "$path" ] && [ "$path" != "@as" ] || continue
  name="$(unquote "$(gsettings get "$SCHEMA.custom-keybinding:$path" name 2>/dev/null || true)")"
  case "$name" in
    "Power menu"|"Shortcuts menu"|"Terminal") ;;
    *) keep+=("$path") ;;
  esac
done

for key in power shortcuts terminal; do
  path="$BASE/custom-o-tiling-$key/"
  gsettings set "$SCHEMA.custom-keybinding:$path" name "${LABEL[$key]}"
  gsettings set "$SCHEMA.custom-keybinding:$path" command "${COMMAND[$key]}"
  gsettings set "$SCHEMA.custom-keybinding:$path" binding "${BIND[$key]}"
  keep+=("$path")
done

list=""
for path in "${keep[@]}"; do list+="'$path', "; done
gsettings set "$SCHEMA" custom-keybindings "[${list%, }]"

# Workspace navigation: mirror i3's Super+<n> / Super+<Shift>+<n> (i3/config:142-163).
gsettings set org.gnome.mutter dynamic-workspaces false
gsettings set org.gnome.desktop.wm.preferences num-workspaces 10

digit_for() { [ "$1" -eq 10 ] && printf 0 || printf '%s' "$1"; }

for i in $(seq 1 10); do
  d="$(digit_for "$i")"
  gsettings set org.gnome.desktop.wm.keybindings "switch-to-workspace-$i" "['<Super>$d']"
  gsettings set org.gnome.desktop.wm.keybindings "move-to-workspace-$i" "['<Super><Shift>$d']"
done

# Free Super+<n> from the dash's app launchers so the workspace bindings win.
for i in $(seq 1 9); do
  gsettings set org.gnome.shell.keybindings "switch-to-application-$i" "[]"
  gsettings set org.gnome.shell.extensions.dash-to-dock "app-hotkey-$i" "[]" 2>/dev/null || true
done

echo "registered: ${LABEL[power]} = ${BIND[power]}, ${LABEL[shortcuts]} = ${BIND[shortcuts]}, ${LABEL[terminal]} = ${BIND[terminal]}, workspaces = Super+1..0 / Super+Shift+1..0"
